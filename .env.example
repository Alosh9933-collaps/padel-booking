# Settings read these environment variables. Development needs none of them.
# In production, set real values (for example via an env file for systemd or Docker;
# never commit that file).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=padel.example.com

DB_NAME=padel
DB_USER=padel
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Online prepayment for online bookings (YooKassa). Without these keys, online bookings
# that need a prepayment are refused. PAYMENTS_DEMO=1 turns on a fake payment page for
# testing: never set it in production.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENTS_DEMO=0
PUBLIC_SITE_URL=https://padel.example.com

# Optional: Telegram alerts, confirmations and reminders.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
